# ----------------------------------------------------------------------
# 1. Python Artifacts and Virtual Environments
# ----------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# IDE-specific caches
.vscode/

# Virtual environments
.venv/
venv/
venv-main/
venv-aux/
env/
# Environments created by 'pipenv'
.direnv/
pip-log.txt

# Package directories
*.egg-info/
.eggs/

# ----------------------------------------------------------------------
# 2. Operating System and Editor Files
# ----------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# ----------------------------------------------------------------------
# 3. Docker and Container Artifacts
# ----------------------------------------------------------------------

# Docker build cache (if generated outside of standard build)
.dockerignore
# Docker Compose temp files
.env
# Generated images (not needed if using a registry like Docker Hub)
# *.tar

# ----------------------------------------------------------------------
# 4. Terraform Files
# ----------------------------------------------------------------------

# Terraform state files (CRITICAL to ignore)
*.tfstate
*.tfstate.*
.terraform/

# Terraform lock files (can often be committed, but frequently ignored)
# If you want to commit the lock file for consistent deployments, remove the lines below.
.terraform.lock.hcl 

# Credential and Variable files (CRITICAL to ignore)
# You should commit main.tf, variables.tf, etc., but IGNORE sensitive variable files.
*.tfvars
terraform.tfvars
*.auto.tfvars

# Backup files generated by Terraform
*~